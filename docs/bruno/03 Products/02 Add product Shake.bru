meta {
  name: Add product Shake
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/franchises/{{franchiseId}}/branches/{{downtownId}}/products
  body: json
  auth: none
}

body:json {
  {
    "name": "Shake",
    "stock": 5
  }
}

script:post-response {
  bru.setVar("shakeId", res.getBody().id);
}

tests {
  test("responds 201 with the stock", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().stock).to.equal(5);
  });
}
