meta {
  name: Rename product
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/franchises/{{franchiseId}}/branches/{{uptownId}}/products/{{burgerId}}/name
  body: json
  auth: none
}

body:json {
  {
    "name": "Double Burger"
  }
}

tests {
  test("responds 200 with the new name", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal("Double Burger");
  });
}
