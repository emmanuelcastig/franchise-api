meta {
  name: Add product Fries
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/franchises/{{franchiseId}}/branches/{{downtownId}}/products
  body: json
  auth: none
}

body:json {
  {
    "name": "Fries",
    "stock": 50
  }
}

script:post-response {
  bru.setVar("friesId", res.getBody().id);
}

tests {
  test("responds 201 with the stock", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().stock).to.equal(50);
  });
}
