meta {
  name: Get top stock product per branch
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/franchises/{{franchiseId}}/top-stock-products
  body: none
  auth: none
}

tests {
  test("lists the best product of every branch with products", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.lengthOf(2);
    expect(body[0]).to.include({ branchName: "Downtown", productName: "Shake", stock: 90 });
    expect(body[1]).to.include({ branchName: "Midtown", productName: "Soda", stock: 80 });
  });
}
