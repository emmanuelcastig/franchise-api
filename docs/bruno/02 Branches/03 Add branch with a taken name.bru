meta {
  name: Add branch with a taken name
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/franchises/{{franchiseId}}/branches
  body: json
  auth: none
}

body:json {
  {
    "name": "Downtown"
  }
}

tests {
  test("responds 409 FRN-410 as problem+json", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody().code).to.equal("FRN-410");
  });
}
