meta {
  name: Rename franchise
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/franchises/{{franchiseId}}/name
  body: json
  auth: none
}

body:json {
  {
    "name": "{{franchiseNewName}}"
  }
}

script:pre-request {
  bru.setVar("franchiseNewName", `${bru.getVar("franchiseName")} Renamed`);
}

tests {
  test("responds 200 with the new name", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal(bru.getVar("franchiseNewName"));
  });
}
